# ──────────────────────────────────────────────
# Environment untuk deploy production (Docker)
# Salin file ini menjadi `.env` lalu sesuaikan
# ──────────────────────────────────────────────

# Base URL backend API (WAJIB diisi).
# Ganti dengan IP/domain backend Anda, sertakan path /api/v1.
PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1

# (Opsional) Port yang dipakai container Node di dalam Docker.
# Default sudah diset ke 3000 di Dockerfile.
# PORT=3000

# (Opsional) Origin publik jika diakses lewat domain / reverse proxy (HTTPS).
# ORIGIN=https://pos.example.com
